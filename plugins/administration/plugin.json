{
  "name": "administration",
  "displayName": "Administration Dashboard",
  "version": "2.0.0",
  "description": "ADB Administration Dashboard - Web-based admin panel, plugin settings host, and reverse-proxy target for plugin UIs",
  "author": "ADB Development Team",
  "main": "index.js",
  "requiresRestart": false,
  "manifestVersion": 2,
  "process": { "model": "persistent", "maxExecutionMs": 30000, "memoryMb": 256, "persistentReason": "Runs the always-on dashboard HTTP server and plugin-settings API" },
  "capabilities": {
    "system": ["raw-client"],
    "storage": ["own-collection", "read-profiles", "write-profiles"]
  },
  "permissions": {
    "storage": ["own-collection", "read-profiles", "write-profiles"],
    "system": ["raw-client"],
    "network": { "outbound": [] },
    "filesystem": { "read": [], "write": [] },
    "childProcess": false,
    "nativeAddons": false
  },
  "discordPermissions": []
}
